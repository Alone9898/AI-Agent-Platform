generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id           Int       @id @default(autoincrement())
  name         String
  description  String?
  systemPrompt String?   @map("system_prompt")
  modelId      Int?      @map("model_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  model  Model?  @relation(fields: [modelId], references: [id], onDelete: SetNull)
  skills AgentSkill[]
  conversations Conversation[]

  @@map("agents")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  nickname     String?
  role         String   @default("admin")
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  conversations Conversation[]

  @@map("users")
}

model Skill {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  type        String    @default("prompt")
  prompt      String?
  tools       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  agents AgentSkill[]

  @@index([type])
  @@index([name])
  @@index([updatedAt])
  @@map("skills")
}

model Model {
  id             Int       @id @default(autoincrement())
  name           String
  provider       String?   @map("provider")
  providerKey    String?   @map("provider_key")
  modelName      String    @map("model_name")
  baseUrl        String?   @map("base_url")
  apiKeyValue    String?   @map("api_key_value")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  agents Agent[]

  @@map("models")
}

model ToolSetting {
  key             String   @id
  provider        String
  baseUrl         String?  @map("base_url")
  apiKeyEncrypted String?  @map("api_key_encrypted")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tool_settings")
}

model AgentSkill {
  agentId Int @map("agent_id")
  skillId Int @map("skill_id")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
  @@map("agent_skills")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  agentId   Int      @map("agent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent    Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, agentId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             Int      @id @default(autoincrement())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  steps          String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}
